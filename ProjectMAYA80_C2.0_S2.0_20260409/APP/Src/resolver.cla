        Cla_angle++;

        Cla_AD2SB_CS_L;


        Cla_AD2SB_SAMPLE_L;
        Cla_delay(1);
        Cla_AD2SB_Test_Ticker++;
        if(Cla_AD2SB_Test_Ticker>5000)
        {

            Cla_AD2SB_Fault = Cla_AD2SB_Read(0xff);

            Cla_AD2SB_Test_Ticker=0;
            if(Cla_AD2SB_Fault!=0)
            {
                Cla_AD2SB_fault_ticker++;
            }
        }

        Cla_angle_rawB=Cla_AD2SB_Postion_Read();


        Cla_mech_angleB=((float)Cla_angle_rawB)/1.0/65536.0;//2^16     1.0??????????
        //Cla_mech_angleB111=((float)Cla_angle_rawB)/1.0/65536.0;

        Cla_angle_tmpB=(-1.0*Cla_mech_angleB)*(POLES_CLA/2.0);
        //Cla_angle_tmpB=(Cla_mech_angleB)*(POLES_CLA/2.0);

        //Cla_angle_tmpB111=(1.0-Cla_mech_angleB111)*(POLES_CLA/2.0);
//        Cla_angle16B=1.0+Cla_angle_tmpB+Cla_ALIGN_ANGLE;//_IQ15frac(angle_tmp);

//        if((Cla_angle16B>=0.0)&&(Cla_angle16B<=1.0))
//        {
//            Cla_correct_angleB=Cla_angle16B;
////            Eangle_resolverB=correct_angleB;
////            M2_Eangle_resolverB =_IQ15frac(Eangle_resolverB+m2_comp);  // M2 generated angle is based on M1 and offset value is 60deg(0.166667pu)
//        }

        Cla_AD2SB_SAMPLE_H;
        Cla_delay(1);
        Cla_AD2SB_SAMPLE_L;
        Cla_delay(1);
        Cla_AD2SB_SAMPLE_H;
        Cla_delay(1);

        Cla_AD2SB_CS_H;
        Cla_angleB = Cla_angle_tmpB;
        //Cla_angleB111=Cla_angle_tmpB111;
//        Cla_angleB = Cla_angle16B;

//        GpioDataRegs.GPBCLEAR.bit.GPIO50 = 1;
}

