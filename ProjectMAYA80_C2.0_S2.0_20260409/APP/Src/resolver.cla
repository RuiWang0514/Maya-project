uint32_t delay_count;
void Cla_delay(uint16_t n)
{
    uint16_t i;
    uint32_t j;
    for(i=0;i<n;i++)
    {
        for(j=0;j<200;j++){

        }
    }
    delay_count++;
}

uint16_t rxval;
uint16_t Cla_AD2SB_Read(uint16_t addr){



    Cla_AD2SB_WR_L;
    SpibRegs.SPITXBUF=(addr<<8);
    while(SpibRegs.SPIFFRX.bit.RXFFST<1){};
    rxval = (SpibRegs.SPIRXBUF);
    Cla_AD2SB_WR_H;
    Cla_delay(1);
    Cla_AD2SB_WR_L;
    SpibRegs.SPITXBUF=(addr<<8);
    while(SpibRegs.SPIFFRX.bit.RXFFST<1){};
    rxval = (SpibRegs.SPIRXBUF);
    Cla_AD2SB_WR_H;
    Cla_delay(1);

    return rxval;
}

uint16_t Cla_AD2SB_Postion_Read(){
    uint16_t rxpos;

    rxpos = Cla_AD2SB_Read(0x80);

    rxpos = (rxpos<<8) | Cla_AD2SB_Read(0x81) ;


    return rxpos;
}


