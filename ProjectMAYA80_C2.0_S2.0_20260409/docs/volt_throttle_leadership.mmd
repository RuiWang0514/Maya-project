%% 电压油门策略（汇报用）
flowchart TB
  subgraph A["输入"]
    IN["油门电压 0～5 V"]
  end

  subgraph B["线性油门（主策略）"]
    B1["有效段：0.5～4.5 V"]
    B2["目标转速与电压线性对应（约 0～2600 r/min）"]
    B3["≥4.5 V：最大转速限幅"]
  end

  subgraph C["滞回（抗门槛抖动）"]
    C1["关断侧：约 0.45 V"]
    C2["开启侧：约 0.55 V"]
    C3["与 0.5 V 线性起点分离，避免反复启停"]
  end

  subgraph D["输出"]
    OUT["转速指令 + 运行使能"]
  end

  IN --> B
  IN --> C
  B --> OUT
  C --> OUT
