#include "F28x_Project.h"
#include "CLAShared.h"

#include "F2837xD_gpio.h"
#include "F2837xD_Cla_defines.h"

#define CLA_DEBUG 0
#define POLES_CLA   40
uint16_t Cla_AD2SB_Test_Ticker;
volatile int Cla_AD2SB_fault_ticker;
static uint32_t Cla_AD2SB_LotActiveCount;
static uint32_t Cla_AD2SB_DosActiveCount;
uint32_t Cla_ResolverRaw;
float Cla_ResolverElecTheta_tmp;
float Cla_angle16B;
float Cla_correct_angleB;
uint32_t delay_count;
void Cla_delay(uint16_t n)
{
    uint16_t i;
    uint32_t j;
    for (i = 0; i < n; i++)
    {
        for (j = 0; j < 200; j++)
        {
        }
    }
    delay_count++;
}

uint16_t rxval;
uint16_t Cla_AD2SB_Read(uint16_t addr)
{
    Cla_AD2SB_WR_L;
    SpibRegs.SPITXBUF = (addr << 8);

    while (SpibRegs.SPIFFRX.bit.RXFFST < 1){};

    rxval = (SpibRegs.SPIRXBUF);
    Cla_AD2SB_WR_H;
    Cla_delay(1);
    Cla_AD2SB_WR_L;
    SpibRegs.SPITXBUF = (addr << 8);

    while (SpibRegs.SPIFFRX.bit.RXFFST < 1){};

    rxval = (SpibRegs.SPIRXBUF);
    Cla_AD2SB_WR_H;
    Cla_delay(1);

    return rxval;
}

uint16_t Cla_AD2SB_Position_Read()
{
    uint16_t rxpos;

    rxpos = Cla_AD2SB_Read(0x80);

    rxpos = (rxpos << 8) | Cla_AD2SB_Read(0x81);

    return (rxpos >> 2);
}


__interrupt void Cla1Task1 (void)
{

}

__interrupt void Cla1Task2 (void)
{
#if (CLA_DEBUG == 1)
    __mdebugstop();
#endif

    Cla_angle++;

    Cla_AD2SB_CS_L;
    Cla_AD2SB_SAMPLE_L;
    Cla_delay(1);

    /* LOT1_R1 / DOS1_R1 are active low. Four consecutive CLA samples
     * suppress a one-cycle input glitch while preserving fast switching. */
    if (GpioDataRegs.GPADAT.bit.GPIO14 == 0u)
    {
        if (Cla_AD2SB_LotActiveCount < 4u)
        {
            Cla_AD2SB_LotActiveCount++;
        }
        if (Cla_AD2SB_LotActiveCount >= 4u)
        {
            Cla_AD2SB_Fault |= 0x08u;   /* AD2SB D3: LOT */
        }
    }
    else
    {
        Cla_AD2SB_LotActiveCount = 0u;
    }

    if (GpioDataRegs.GPADAT.bit.GPIO15 == 0u)
    {
        if (Cla_AD2SB_DosActiveCount < 4u)
        {
            Cla_AD2SB_DosActiveCount++;
        }
        if (Cla_AD2SB_DosActiveCount >= 4u)
        {
            /* GPIO15 is the combined DOS output: D5 or D4 occurred. */
            Cla_AD2SB_Fault |= 0x30u;
        }
    }
    else
    {
        Cla_AD2SB_DosActiveCount = 0u;
    }

    Cla_AD2SB_Test_Ticker++;
    if (Cla_AD2SB_Test_Ticker >= 400u) /* 20ms @ 20kHz */
    {
        uint16_t raw_fault;
        raw_fault = Cla_AD2SB_Read(0xff) & 0xff;

        Cla_AD2SB_Fault |= raw_fault;
        Cla_AD2SB_Test_Ticker = 0;

        if (raw_fault != 0u)
        {
            Cla_AD2SB_fault_ticker++;
        }
    }

    Cla_ResolverRaw = Cla_AD2SB_Position_Read();

    Cla_ResolverMechTheta_pu = ((float)Cla_ResolverRaw) / 1.0 / 16384.0f; // 2^14
    Cla_ResolverElecTheta_tmp = (-1.0 * Cla_ResolverMechTheta_pu) * (POLES_CLA / 2.0);

    Cla_AD2SB_SAMPLE_H;
    Cla_delay(1);
    Cla_AD2SB_SAMPLE_L;
    Cla_delay(1);
    Cla_AD2SB_SAMPLE_H;
    Cla_delay(1);

    Cla_AD2SB_CS_H;
    Cla_ResolverElecTheta_pu = Cla_ResolverElecTheta_tmp;
}

